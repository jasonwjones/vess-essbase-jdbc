<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.jasonwjones.hyperion.vess</groupId>
	<artifactId>vess-essbase-jdbc</artifactId>
	<version>1.0.0</version>
	<name>Vess Essbase JDBC Driver</name>
	<description>A JDBC driver that presents a whole Essbase server - applications, cubes, outlines, data, variables and scripts - as SQL tables, over the REST API</description>
	<url>https://github.com/jasonwjones/vess-essbase-jdbc</url>
	<inceptionYear>2015</inceptionYear>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Jason Jones</name>
			<url>https://www.jasonwjones.com</url>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/jasonwjones/vess-essbase-jdbc</url>
		<connection>scm:git:https://github.com/jasonwjones/vess-essbase-jdbc.git</connection>
		<developerConnection>scm:git:https://github.com/jasonwjones/vess-essbase-jdbc.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>17</maven.compiler.release>
		<calcite.version>1.42.0</calcite.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Calcite and essbase-rest-client both use Jackson; one version for both -->
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>2.22.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- vess.properties carries the version, for the driver to report -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>**/vess.properties</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/vess.properties</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
			</plugin>
			<!-- A single jar to hand a SQL tool, beside the plain one. Services are
				merged so java.sql.Driver names Vess (and Thriller, which comes with
				it), but not Calcite's own drivers, which a tool would otherwise offer
				as choices; and signatures are dropped because they no longer match
				once the jars are combined. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>all</shadedClassifierName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.apache.calcite:*</artifact>
									<excludes>
										<exclude>META-INF/services/java.sql.Driver</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>org.apache.calcite.avatica:*</artifact>
									<excludes>
										<exclude>META-INF/services/java.sql.Driver</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Publishing to Maven Central, which the release workflow does for a
			vX.Y.Z tag: sources, Javadoc and signatures for every artifact, the
			single jar included, then an upload Central publishes on its own. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.12.0</version>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<configuration>
									<!-- Loopback pinentry reads the passphrase from the
										environment rather than trying to open a terminal. -->
									<gpgArguments>
										<arg>--pinentry-mode</arg>
										<arg>loopback</arg>
									</gpgArguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<!-- 0.12.0 or later: under Maven 3.10, earlier versions bundle files
							Central rejects. -->
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<!-- Validation is quick; publication can outlast the plugin's
								timeout and look like a failure when it isn't. -->
							<waitUntil>validated</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<dependencies>
		<!-- The SQL engine. What's excluded serves features Vess doesn't offer:
			model files, lattices, sketches, the remote driver and the JDBC
			adapter. The spatial library stays: the engine loads it regardless. -->
		<dependency>
			<groupId>org.apache.calcite</groupId>
			<artifactId>calcite-core</artifactId>
			<version>${calcite.version}</version>
			<exclusions>
				<exclusion>
					<groupId>com.fasterxml.jackson.dataformat</groupId>
					<artifactId>jackson-dataformat-yaml</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.uzaygezen</groupId>
					<artifactId>uzaygezen-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.yahoo.datasketches</groupId>
					<artifactId>sketches-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.hydromatic</groupId>
					<artifactId>aggdesigner-algorithm</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.commons</groupId>
					<artifactId>commons-dbcp2</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.httpcomponents.client5</groupId>
					<artifactId>httpclient5</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Calcite's lenient parser, so that Essbase names such as Year, Time and
			Value can be written without quotes -->
		<dependency>
			<groupId>org.apache.calcite</groupId>
			<artifactId>calcite-babel</artifactId>
			<version>${calcite.version}</version>
		</dependency>
		<dependency>
			<groupId>com.appliedolap.essbase</groupId>
			<artifactId>essbase-rest-client</artifactId>
			<version>2.1.0</version>
		</dependency>
		<!-- MDX statements run through Thriller, and its result sets serve
			Vess's own metadata -->
		<dependency>
			<groupId>com.jasonwjones.hyperion.thriller</groupId>
			<artifactId>thriller-mdx-jdbc</artifactId>
			<version>1.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.18</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
